{
  "name": "how-i-choose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first communication rehearsal workspace that evaluates whether the communication partner adapted.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start:static": "serve out -l 4173 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:a11y-assisted": "node scripts/assisted-accessibility-smoke.mjs",
    "capture:preview": "node scripts/capture-preview.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "deploy": "node scripts/deploy.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "dexie": "4.4.5",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
